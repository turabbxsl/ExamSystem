@{
    Layout = "_Layout";
    ViewData["Title"] = "İdarəetmə Paneli";
}

<div class="container-fluid" id="model" v-cloak>
    <div class="row">
        <div class="col-lg-12">
            <div class="page-header">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
        </div>

        <div class="col-lg-4 mt-3">
            <div class="card shadow-sm border-0 p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-primary bg-opacity-10 p-3 rounded text-primary">
                        <i class="fa-solid fa-user-graduate fa-2x"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="text-muted mb-0">Şagird sayı</h6>
                        <h3 class="fw-bold mb-0">{{ stats.studentCount }}</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mt-3">
            <div class="card shadow-sm border-0 p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-success bg-opacity-10 p-3 rounded text-success">
                        <i class="fa-solid fa-book fa-2x"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="text-muted mb-0">Dərs sayı</h6>
                        <h3 class="fw-bold mb-0">{{ stats.courseCount }}</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mt-3">
            <div class="card shadow-sm border-0 p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 bg-warning bg-opacity-10 p-3 rounded text-warning">
                        <i class="fa-solid fa-file-pen fa-2x"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="text-muted mb-0">İmtahan sayı</h6>
                        <h3 class="fw-bold mb-0">{{ stats.examCount }}</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var Model = new Vue({
            el: '#model',
            data: {
                stats: {
                    studentCount: 0,
                    courseCount: 0,
                    examCount: 0
                }
            },
            mounted() {
                this.loadStats();
            },
            methods: {
                async loadStats() {
                    this.loading = true;

                    try {
                        const r = await axios.get('/dashboard/stats');

                        console.log(r);

                        if (r.data.isSuccess) {
                            this.stats = r.data.data.value;
                        } else {
                            r.data.errors.forEach(e => notify('error', e));
                        }
                    }
                    catch (error) {
                        notify('error', 'Sistemdə gözlənilməz bir xəta baş verdi.');
                    }
                    finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
}